{
  "name": "55ndeep",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Deterministic delegation plugin for coding agents \u2014 verification, correction, and routing layer that plugs into Codex, Claude Code, OpenCode, and LangChain-style systems",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "test": "bash scripts/test-batched.sh",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage.enabled=true",
    "typecheck": "tsc --noEmit",
    "lint": "eslint packages apps",
    "clean": "rm -rf packages/*/dist apps/*/dist packages/*/tsconfig.tsbuildinfo apps/*/tsconfig.tsbuildinfo",
    "test:adapter": "bash examples/shell-adapter/test-adapter.sh",
    "ci": "bash scripts/ci.sh",
    "cli": "npx tsx apps/cli/src/index.ts",
    "test:ci": "bash scripts/ci.sh",
    "test:e2e": "vitest run e2e/",
    "test:all": "bash scripts/test-batched.sh && vitest run e2e/",
    "docs:api": "typedoc"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.218.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-metrics": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "commander": "^13.0.0",
    "zod": "^3.24.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "Apache-2.0"
}
