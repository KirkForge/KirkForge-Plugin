{
  "version": 1,
  "name": "kirkforge-mini-bench-policy",
  "tools": {
    "allowed": [
      "text",
      "typescript",
      "python",
      "javascript",
      "json",
      "shell",
      "shell_exec",
      "file_read",
      "file_write",
      "file_list",
      "delegation",
      "unknown"
    ],
    "denied": []
  },
  "models": {
    "allowed": [
      "minimax-m3:cloud"
    ],
    "allowedProviders": [
      "local-ollama"
    ]
  },
  "workspaces": {
    "allowedRoots": [
      "/tmp/kirkforge-mini",
      "/home/kirk/Madlab/Clean-Live/KirkForgeSeries/KirkForge-Plugin"
    ]
  },
  "execution": {
    "networkAllowed": true,
    "maxRuntimeSeconds": 600,
    "shellAllowed": true,
    "allowedCommands": [
      "*"
    ]
  }
}
